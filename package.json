{
  "name": "@misofm/engine-web-adapter",
  "version": "0.1.0",
  "description": "Codec-neutral browser session adapter for @misofm/engine",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/internal/*.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stems": {
      "types": "./dist/stems/index.d.ts",
      "import": "./dist/stems/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@misofm/engine": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
