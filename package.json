{
  "name": "@misofm/engine-web-adapter",
  "version": "0.5.11",
  "description": "Bounded FLAC browser session adapter for @misofm/engine using @misofm/codec",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/engine-web-adapter.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/internal/*.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stems": {
      "types": "./dist/stems/index.d.ts",
      "import": "./dist/stems/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.23.2 <23",
    "bun": ">=1.4.2 <1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:sha256:wasm": "node scripts/build-sha256-wasm.mjs --verify",
    "build:sha256:wasm:update": "node scripts/build-sha256-wasm.mjs --update",
    "build:blake3:wasm": "node scripts/build-blake3-wasm.mjs --verify",
    "build:blake3:wasm:update": "node scripts/build-blake3-wasm.mjs --update",
    "prepack": "npm run build",
    "format:check": "node scripts/check-format.mjs",
    "lint": "npm run typecheck && node scripts/check-source-policy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/clean-test-dist.mjs && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:browser": "node scripts/browser-packed.mjs",
    "test:browser:live": "node scripts/browser-packed.mjs --live",
    "test:browser:opfs": "node scripts/browser-opfs.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "check:decoder": "node scripts/check-flac-decoder.mjs",
    "publish:dry-run": "npm publish --dry-run",
    "check": "npm run format:check && npm run build:sha256:wasm && npm run build:blake3:wasm && npm run lint && npm run check:decoder && npm test && npm run check:package"
  },
  "dependencies": {
    "@misofm/codec": "0.1.1",
    "@misofm/engine": "0.4.1",
    "effect": "4.0.0-rc.112",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
